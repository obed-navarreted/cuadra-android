<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app viaja en copias de seguridad ni en transferencias entre teléfonos: los tokens están ligados a la clave de este
     teléfono (Keystore) y las ventas sin sincronizar deben volver a nacer donde se hicieron, nunca duplicarse en otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
